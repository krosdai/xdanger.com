{
  "name": "eccentric-event",
  "version": "6.2.0",
  "license": "CC-BY-SA-4.0",
  "type": "module",
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/ensure-anyip-cert.mjs && astro dev",
    "start": "pnpm run dev",
    "cert:anyip": "node scripts/ensure-anyip-cert.mjs --force",
    "build": "pnpm run build:site && pnpm run build:search",
    "build:site": "astro build",
    "build:debug": "cross-env NODE_OPTIONS=--trace-warnings pnpm run build:site",
    "build:search": "pagefind --site dist",
    "rebuild": "pnpm run build:site",
    "rebuild:og": "cross-env REFRESH_OG_IMAGES=1 pnpm run build:site",
    "preview": "node scripts/preview-server.mjs",
    "lint": "mise run autocorrect:lint && oxfmt --check && prettier --check --no-error-on-unmatched-pattern \"**/*.{astro,json,jsonc,json5,yaml,yml,html,htm,css,scss,less,vue,graphql,gql,hbs,handlebars}\" && oxlint && astro check --tsconfig tsconfig.json",
    "fix": "mise run autocorrect:fix && oxfmt && prettier --write --no-error-on-unmatched-pattern \"**/*.{astro,json,jsonc,json5,yaml,yml,html,htm,css,scss,less,vue,graphql,gql,hbs,handlebars}\" && oxlint --fix"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "astro-robots-txt": "^1.0.0",
    "astro-webmanifest": "^1.0.0",
    "cssnano": "^8.0.4",
    "hastscript": "^9.0.1",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/circum": "^1.2.2",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/material-symbols-light": "^1.2.93",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.11",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
